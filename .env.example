OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Google Workspace / Gmail defaults are inferred when only these two are set.
EMAIL_USER=you@example.com
EMAIL_APP_PASSWORD=

# Optional overrides.
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=you@example.com
EMAIL_LOOKBACK_DAYS=30
EMAIL_MAX_FETCH=50

# By default, JESSA allows localhost and 10.x.x.x clients.
JESSA_ALLOWED_CLIENT_NETWORKS=127.0.0.0/8,::1/128,10.0.0.0/8

# Optional. Useful when Playwright cannot install bundled Chromium for the OS.
# Linux example: /usr/bin/google-chrome
# macOS example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PLAYWRIGHT_BROWSER_PATH=

# App paths.
JESSA_DB_PATH=data/jessa.sqlite3
JESSA_PROFILE_SOURCE=jessa_gpt_instructions.txt
JESSA_RESUME_DIR=~/Documents/job_hunting

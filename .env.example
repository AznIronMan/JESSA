OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Google Workspace / Gmail defaults are inferred when only these two are set.
EMAIL_USER=you@example.com
EMAIL_APP_PASSWORD=

# Optional overrides.
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=you@example.com
EMAIL_LOOKBACK_DAYS=30
EMAIL_MAX_FETCH=50

# PostgreSQL is required for JESSA 2.x runtime storage.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=jessa
POSTGRES_PASS=
POSTGRES_DB_NAME=jessa
POSTGRES_SSLMODE=prefer

# By default, JESSA allows localhost and 10.x.x.x clients.
JESSA_ALLOWED_CLIENT_NETWORKS=127.0.0.0/8,::1/128,10.0.0.0/8

# Optional. Useful when Playwright cannot install bundled Chromium for the OS.
# Linux example: /usr/bin/google-chrome
# macOS example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PLAYWRIGHT_BROWSER_PATH=

# App paths.
# Legacy SQLite path used only by scripts/migrate_sqlite_to_postgres.py.
JESSA_SQLITE_IMPORT_PATH=data/jessa.sqlite3
# Optional one-time seed file for a new empty core_profile row.
JESSA_PROFILE_SOURCE=
JESSA_RESUME_DIR=~/Documents/job_hunting

# LinkedIn support uses a local, visible, persistent browser profile.
JESSA_LINKEDIN_PROFILE_URL=
JESSA_LINKEDIN_BROWSER_PROFILE_DIR=data/linkedin-browser
JESSA_LINKEDIN_PAGE_SETTLE_MS=7000
JESSA_LINKEDIN_LOGIN_WAIT_MS=180000
JESSA_LINKEDIN_PROFILE_CAPTURE_WAIT_MS=180000
JESSA_LINKEDIN_PROFILE_SCROLL_PASSES=8
JESSA_LINKEDIN_MIN_PROFILE_CONTENT_CHARS=400
